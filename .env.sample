# --- Nextcloud credentials (CLI/stdio mode only) ---
# Used when running the server in CLI mode (npm run dev, npm run cli).
# NOT used by the HTTP server - each HTTP client provides their own credentials.
NEXTCLOUD_HOST=https://your.nextcloud.instance.com
NEXTCLOUD_USERNAME=your_nextcloud_username
NEXTCLOUD_PASSWORD=your_nextcloud_app_password_or_login_password

# --- HTTP server: Self-Hosted mode ---
# Required when NOT using the MCP Key Service.
# Clients must also send X-Nextcloud-* headers with their credentials.
# Generate a strong key: openssl rand -hex 32
MCP_API_KEY=your-secret-api-key-here

# --- HTTP server: Key Service mode (multi-user) ---
# When both are set, user API keys (usr_XXXXXXXX) are resolved via the
# MCP Key Service to retrieve Nextcloud credentials automatically.
# MCP_API_KEY is still used for the /analytics admin endpoint.
KEY_SERVICE_URL=
KEY_SERVICE_TOKEN=

# --- Optional ---
# Comma-separated list of allowed CORS origins.
# Defaults to: https://smithery.ai,https://claude.ai
ALLOWED_ORIGINS=https://smithery.ai,https://claude.ai
